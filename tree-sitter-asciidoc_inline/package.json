{
  "name": "tree-sitter-asciidoc_inline",
  "version": "0.9.0",
  "description": "asciidoc_inline grammar for tree-sitter",
  "repository": "github:cathaysia/tree-sitter-asciidoc_inline",
  "license": "Apache-2.0",
  "author": "Loongtao Zhang <loongtao.zhang@outlook.com>",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter generate && tree-sitter test && sh test/injections.sh"
  },
  "files": [
    "grammar.js",
    "queries/*",
    "src/**"
  ],
  "tree-sitter": [
    {
      "scope": "source.asciidoc_inline",
      "injection-regex": "^asciidoc_inline$"
    }
  ]
}
